# Normalize line endings for cross-platform compatibility
* text=auto eol=lf

# Force LF for source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
